	"extras": {
		"weights": "per channel: the causal long convolution as a T × T Toeplitz matrix, h[i - j] below the diagonal and h[0] + D on it",
		"v": "x₁ ⊙ v, the gated values the long convolution mixes",
		"heads": "the long convolution’s output, recorded from the operator’s own FFT convolution",
		"gate1": "x₁ (d, T): the gate applied to v before the long convolution",
		"gate2": "x₀ (d, T): the gate applied to the convolution’s output",
		"vRaw": "v (d, T) after the short convolution, before the gate",
		"filter": "the implicit filter h (d, 1026) at every lag the model supports"
	}
